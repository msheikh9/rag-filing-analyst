# Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sec_filings

# Embedding Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM Configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Search Configuration
TOP_K=5

# Retrieval. "hybrid" = dense + BM25 sparse, fused with RRF inside Qdrant. "dense" = the
# original single-vector path. Hybrid requires a collection built by scripts/index_hybrid.py
# or the rewritten scripts/index_sec_dataset.py; it cannot read a dense-only collection.
RETRIEVAL_MODE=hybrid
SPARSE_MODEL=Qdrant/bm25
PREFETCH_LIMIT=50

# Cross-encoder reranking. Off by default — it did not improve nDCG@10 beyond noise on the
# current corpus while adding ~200ms at p50. See docs/EVALUATION.md.
ENABLE_RERANK=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_DEPTH=30

# Application Configuration
LOG_LEVEL=INFO
DEBUG=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true