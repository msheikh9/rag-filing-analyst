# Everything in this stack runs locally. There are no hosted-API keys because no filing text
# leaves the machine: embeddings come from a local sentence-transformers model, BM25 is computed
# inside Qdrant, and generation is a local Ollama model.
#
# Service-level configuration lives in backend/.env.example; keep the two in sync.

# Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sec_filings

# Embeddings (local, 384-dim)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM (local, via Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Retrieval. "hybrid" = dense + BM25 sparse, fused with RRF inside Qdrant. "dense" = the
# original single-vector path. Hybrid needs a collection with named vectors — see
# scripts/index_sec_dataset.py.
RETRIEVAL_MODE=hybrid
SPARSE_MODEL=Qdrant/bm25
PREFETCH_LIMIT=50
TOP_K=5

# Cross-encoder reranking. Off by default — no measurable nDCG@10 gain on the current corpus
# for ~200ms at p50. See docs/EVALUATION.md.
ENABLE_RERANK=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_DEPTH=30
